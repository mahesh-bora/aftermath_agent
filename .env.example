# ── Aftermath service auth key ────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
AFTERMATH_API_KEY=your_aftermath_api_key_here

# ── Optional server-side Google key (fallback if caller doesn't send BYOK header)
# If omitted, every caller MUST pass X-Google-API-Key header.
# Get a key free at https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...

# ── Optional overrides ────────────────────────────────────────────────────────
# GEMINI_MODEL=gemini-2.5-flash
# AFTERMATH_DEBUG=1
# PORT=8000
# CORS_ORIGINS=https://yourapp.com,https://app2.com
